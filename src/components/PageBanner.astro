---
import NetworkArt from './NetworkArt.astro';
import type { Lang } from '../lib/i18n';
const { lang, zh, en, tag = 'h1' } = Astro.props as { lang: Lang; zh: string; en: string; tag?: 'h1' | 'div' };
const Tag = tag;
---
<section class="page-banner">
  <NetworkArt class="art-right" />
  <NetworkArt class="art-left" />
  <div class="container">
    <Tag class="banner-title">{lang === 'zh' ? zh : en}</Tag>
    {lang === 'zh' && en && <p class="banner-sub" lang="en">{en}</p>}
    <slot />
  </div>
</section>

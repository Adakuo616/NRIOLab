---
import Base from '../layouts/Base.astro';
import { UI, href } from '../lib/i18n';
---
<Base lang="zh" path="404/" title={UI.zh.notFound} noindex>
  <div class="container empty-page">
    <h1 class="page-title">404</h1>
    <p>{UI.zh.notFound}</p>
    <p><a class="btn" href={href('', 'zh')}>{UI.zh.home}</a></p>
  </div>
</Base>

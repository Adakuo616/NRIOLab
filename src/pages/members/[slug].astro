---
import View from '../../views/MemberDetail.astro';
import data from '../../data/members.json';
import { hasDetail } from '../../lib/members';

export function getStaticPaths() {
  return data.items.filter(hasDetail).map((member: any) => ({ params: { slug: member.slug }, props: { member } }));
}
---
<View lang="zh" member={Astro.props.member} />

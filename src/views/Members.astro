---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { UI, navItem, t, asset, type Lang } from '../lib/i18n';
import data from '../data/members.json';

const { lang } = Astro.props as { lang: Lang };
const ui = UI[lang];
const nav = navItem('members');
const title = nav[lang];
const roles = Object.keys(ui.roles) as (keyof typeof ui.roles)[];
const groups = roles.map((role) => ({ role, list: data.items.filter((m: any) => m.role === role) })).filter((g) => g.list.length);
---
<Base lang={lang} path="members/" navId="members" title={title}>
  <PageBanner lang={lang} zh={nav.zh} en={nav.en} />
  <div class="container">
    {groups.length ? groups.map((g) => (
      <section class="member-group">
        <h2>{ui.roles[g.role]}</h2>
        <div class="grid member-grid">
          {g.list.map((m: any) => (
            <div class="card member-card">
              {m.photo ? <img src={asset(m.photo)} alt={t(m, 'name', lang)} loading="lazy" width="112" height="112"> : <div class="avatar-ph" />}
              <h3>{t(m, 'name', lang)}</h3>
              {t(m, 'title', lang) && <div class="muted">{t(m, 'title', lang)}</div>}
              {m.year && <div class="muted">{lang === 'zh' ? '入學：' : 'Entrance: '}{m.year}</div>}
              {t(m, 'research', lang) && (
                <ul class="member-research" aria-label={ui.research}>
                  {t(m, 'research', lang).split(/\n+/).filter(Boolean).map((r: string) => <li>{r.replace(/^[-*•]\s*/, '')}</li>)}
                </ul>
              )}
              {m.email && <a href={`mailto:${m.email}`}>{m.email}</a>}
            </div>
          ))}
        </div>
      </section>
    )) : <p class="empty">{ui.empty}</p>}
  </div>
</Base>

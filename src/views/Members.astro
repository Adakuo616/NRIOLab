---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import MemberCard from '../components/MemberCard.astro';
import { UI, navItem, href, type Lang } from '../lib/i18n';
import data from '../data/members.json';
import { hasDetail } from '../lib/members';

const { lang, role: only } = Astro.props as { lang: Lang; role?: string };
const ui = UI[lang];
const nav = navItem(only || 'members');
const navPath = only ? nav.path : 'members/';
const roles = Object.keys(ui.roles) as (keyof typeof ui.roles)[];
const yearNum = (y: string) => parseInt(y, 10) || 0;
// Group by role, then by entrance year (newest first).
const groups = roles.filter((r) => !only || r === only).map((role) => {
  const list = data.items.filter((m: any) => m.role === role);
  const years = [...new Set(list.map((m: any) => m.year || ''))].sort((a, b) => yearNum(b) - yearNum(a));
  return { role, years: years.map((y) => ({ year: y, list: list.filter((m: any) => (m.year || '') === y) })) };
}).filter((g) => g.years.length);
const memberHref = (m: any) => m.role === 'pi' ? href('professor/', lang) : hasDetail(m) ? href(`members/${m.slug}/`, lang) : undefined;
const entrance = (y: string) => lang === 'zh' ? y : y.replace('學年度', ' (ROC academic year)');
---
<Base lang={lang} path={navPath} navId={only || 'members'} title={nav[lang]}>
  <PageBanner lang={lang} zh={nav.zh} en={nav.en} />
  <div class="container">
    {groups.length ? groups.map((g) => (
      <section class="member-group">
        {!only && <h2>{ui.roles[g.role]}</h2>}
        {g.years.map((y) => (
          <>
            {(only ? !!y.year : g.years.length > 1 && y.year) && <h3 class="member-year">{entrance(y.year)}</h3>}
            <div class="grid member-grid">
              {y.list.map((m: any) => (
                <MemberCard m={m} lang={lang} link={memberHref(m)} />
              ))}
            </div>
          </>
        ))}
      </section>
    )) : <p class="empty">{ui.empty}</p>}
  </div>
</Base>

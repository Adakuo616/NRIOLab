---
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import Icon from '../components/Icon.astro';
import NetworkArt from '../components/NetworkArt.astro';
import Stars from '../components/Stars.astro';
import { UI, t, asset, href, site, type Lang } from '../lib/i18n';
import { getCurrentNews } from '../lib/news';
import prof from '../data/professor.json';
import life from '../data/life.json';

const { lang } = Astro.props as { lang: Lang };
const ui = UI[lang];
const zh = lang === 'zh';

const withPhoto = (await getCurrentNews()).filter((n) => n.data.images?.length);
const featured = withPhoto.slice(0, 3);
// One photo per 生活點滴 event for the mosaic.
const lifePhotos = life.items.flatMap((it: any) => (it.images || []).slice(0, 1).map((src: string) => ({ src, title: t(it, 'title', lang), alt: t(it, 'title', lang) })));
const photos = lifePhotos.slice(0, 5);

// Break the Chinese title before 「實驗室」 so it never splits mid-word.
const fullName = site.name_zh_full || site.name_zh;
const titleParts = fullName.endsWith('實驗室') ? [fullName.slice(0, -3), '實驗室'] : [fullName];
const origin = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: t(site, 'name', lang), alternateName: site.short_name, url: origin, inLanguage: zh ? 'zh-Hant' : 'en' },
  {
    '@context': 'https://schema.org', '@type': 'ResearchOrganization', name: site.name_zh, alternateName: [site.name_en, site.short_name], url: origin,
    ...(site.logo ? { logo: new URL(asset(site.logo), Astro.site).href } : {}),
    ...(site.email ? { email: site.email } : {}),
    ...(site.phone ? { telephone: site.phone } : {}),
    ...(site.address_zh ? { address: { '@type': 'PostalAddress', streetAddress: site.address_zh, addressLocality: '台北市', addressCountry: 'TW' } } : {}),
    ...(site.institution_zh ? { parentOrganization: { '@type': 'CollegeOrUniversity', name: site.institution_zh } } : {})
  }
];
---
<Base lang={lang} path="" navId="" jsonLd={jsonLd}>
  <section class="hero">
    <Stars count={110} />
    <NetworkArt class="art-left" />
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.short_name}</p>
        <h1 class="hero-title">{zh ? titleParts.map((p) => <span>{p}</span>) : site.name_en}</h1>
        {zh && <p class="hero-en" lang="en">{site.tagline_en_full}</p>}
        {t(site, 'hero_lead', lang) && <p class="hero-lead">{t(site, 'hero_lead', lang)}</p>}
        <div class="hero-actions">
          <a class="btn" href={href('news/', lang)}>{zh ? '最新消息' : 'Latest News'}</a>
          <a class="btn btn-ghost" href={href('introduction/', lang)}>{zh ? '認識實驗室' : 'About the Lab'}</a>
        </div>
      </div>
      <div class="hero-visual">
        <NetworkArt class="art-hero" />
        {(site.logo_hero || site.logo) && <img class="hero-logo" src={asset(site.logo_hero || site.logo)} alt={site.short_name} width="608" height="320">}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="sec-head reveal">
        <div><p class="eyebrow">News</p><h2>{ui.latest}</h2></div>
        <a class="more-link" href={href('news/', lang)}>{ui.more}</a>
      </header>
      <div class="news-cards">{featured.map((n) => <NewsCard entry={n} lang={lang} />)}</div>
    </div>
  </section>

  {site.highlights?.length > 0 && (
    <section class="section band">
      <div class="container">
        <header class="sec-head reveal">
          <div><p class="eyebrow">Research</p><h2>{zh ? '研究方向' : 'Research Focus'}</h2></div>
          <a class="more-link" href={href('introduction/', lang)}>{zh ? '實驗室介紹' : 'Introduction'}</a>
        </header>
        <div class="research-cards">
          {site.highlights.map((h: any, i: number) => (
            <article class="r-card reveal" style={`--d:${i * 90}ms`}>
              <span class="r-icon"><Icon name={['network', 'simulation', 'ai'][i % 3]} /></span>
              <span class="r-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t(h, 'title', lang)}</h3>
              <p>{t(h, 'text', lang)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="home-split reveal">
        <div>
          <header class="sec-head"><div><p class="eyebrow">Professor</p><h2>{zh ? '指導教授' : 'Professor'}</h2></div></header>
          <div class="pi-feature">
            {prof.photo && <img src={asset(prof.photo)} alt={t(prof, 'name', lang)} width="150" height="150" loading="lazy">}
            <div>
              <h3>{t(prof, 'name', lang)}{zh && prof.name_en && <small lang="en">{prof.name_en}</small>}</h3>
              <p>{t(prof, 'department', lang)} {t(prof, 'title', lang)}</p>
              <a class="btn" href={href('professor/', lang)}>{zh ? '教授介紹' : 'Profile'} →</a>
            </div>
          </div>
        </div>
        {photos.length > 0 && (
          <div>
            <header class="sec-head">
              <div><p class="eyebrow">Life</p><h2>{zh ? '生活點滴' : 'Life'}</h2></div>
              <a class="more-link" href={href('life/', lang)}>{ui.more}</a>
            </header>
            <div class="photo-mosaic">
              {photos.map((p) => (
                <a href={href('life/', lang)}><figure style="margin:0;height:100%"><img src={asset(p.src)} alt={p.title} loading="lazy"><figcaption>{p.title}</figcaption></figure></a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
